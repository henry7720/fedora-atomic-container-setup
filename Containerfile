# Start from the official Fedora 44 Kinoite OCI image OR fedora-bootc (headless/custom minimal desktop: see the Containerfile-minimalist-custom)
FROM quay.io/fedora/fedora-kinoite:44

# Add repos here before install
# RUN tee ...repo contents here... to go into repo file/curl download... / 'dnf config-manager add repo' commands

# Add any custom COPY commands here, say for fonts

# I recommend following one RUN block for removals, for hardware drivers and codecs (RPMFusion etc.) and for your GUI apps/extra CLI tools
# Since we're using bootc, we use standard dnf commands, you can just install and also swap toolbox for distrobox, etc.
# Use -y for all dnf commands as it can't be interactive
# We set a mount cache directory to map to the repo result cache dir so we can build faster and also spare some container size
# We also made some tmpfs folders which are not meant to persist after build-time - these should be set as they are
# The second dnf install setup expresses how to string together another dnf/other command with special options - this can be removed by removing the && and all that follows after it in that RUN block
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    --mount=type=tmpfs,target=/run \
    --mount=type=tmpfs,target=/tmp \
    --mount=type=tmpfs,target=/var/tmp \
    --mount=type=tmpfs,target=/var/log \
    --mount=type=tmpfs,target=/root/.cache \
    dnf -y install \
    package-here && \
    dnf -y install --special-options \
    package-here

# Optional custom services enable/disable or none at all can go here as Fedora default-enables most.
# Stringing together with && is a good idea.
# If you don't know what you are doing, don't mess with it. If you do, combine this run block with the following two with &&
# RUN systemctl enable non-default.service

# Here you can run any image-layer-level /etc overrides. Useful if you don't want to have to think about these or have a specific need.
# In general, not necessary at all, but YMMV. You can always do these configs manually.
# If you don't know what you are doing, don't mess with it.  If you do, combine this run block with the previous and follow with &&
# RUN echo "some-content" > /etc/some-default-os-config

# DO NOT change the below content if you don't understand bootc images - this script ensures that packages' folders and special permissions are set to persist on your computer
# This prevents crashes, don't merge with the package install block without changing the DNF cache location/excluding /var/cache/libdnf5 from the find -delete commands
RUN find /var -type f -delete && \
    bootc container lint --no-truncate 2>&1 | awk '/^[[:space:]]*[dL] \/var\// { $1=$1; print }' > /usr/lib/tmpfiles.d/bootc-autogenerated.conf && \
    find /var -mindepth 2 -delete && \
    bootc container lint --no-truncate

# Important: Label the image as bootc-compatible
LABEL containers.bootc=1
