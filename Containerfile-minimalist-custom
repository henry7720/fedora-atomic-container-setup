# sudo bootc switch --transport containers-storage localhost/henry-os-test:test
#sudo podman build -t localhost/henry-os-test:test .
FROM quay.io/fedora/fedora-bootc:44

#https://community.kde.org/Distributions/Packaging_Recommendations
# 1. Install hardware & multimedia groups + minimal Wayland/compositor stack
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    --mount=type=tmpfs,target=/run \
    --mount=type=tmpfs,target=/tmp \
    --mount=type=tmpfs,target=/var/tmp \
    --mount=type=tmpfs,target=/var/log \
    # Removals (annoying shell message) for the annoying failure systemd-remount-fs (cosmetic bug)
    dnf -y remove console-login-helper-messages && \
    # External repos
    curl -fsSL https://pkgs.tailscale.com/stable/fedora/tailscale.repo -o /etc/yum.repos.d/tailscale.repo && \
    dnf -y --refresh install \
        https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm && \
    # The mass install!
    dnf install -y --setopt="install_weak_deps=False" \
        mesa-vulkan-drivers-freeworld mesa-dri-drivers mesa-va-drivers-freeworld \
        plasma-desktop \
        glibc-langpack-en \
        kdegraphics-thumbnailers kio-admin qrca thermald unrar xsettingsd \
        kinfocenter \
        konsole \
        plasma-nm plasma-nm-openvpn NetworkManager-wifi NetworkManager-config-connectivity-fedora \
        virt-manager libvirt-daemon-kvm libvirt-daemon-config-network libayatana-appindicator-gtk3 libappindicator-gtk3 \
        btrfs-assistant btrfsmaintenance snapper \
        plasma-discover plasma-discover-flatpak \
        pam-kwallet \
        plasma-pa bluedevil pipewire pipewire-alsa alsa-sof-firmware alsa-ucm pipewire-pulseaudio wireplumber pipewire-codec-aptx \
        powerdevil upower tuned tuned-ppd \
        plasma-print-manager cups cups-browsed cups-filters-driverless ipp-usb nss-mdns \
        firewalld plasma-firewall plasma-firewall-firewalld \
        dolphin dolphin-plugins ffmpegthumbs qt6-qtimageformats kf6-kimageformats \
        plasma-login-manager \
        fprintd fprintd-pam \
        colord-kde kscreen \
        ark spectacle \
        bash-color-prompt \
        systemd-oomd-defaults \
        breeze-gtk kde-gtk-config plasma-oxygen oxygen-cursor-themes oxygen-sounds \
        # oxygen-fonts NOT NEEDED, vf-fonts used on noto-serif to save some space
        jetbrains-mono-fonts google-noto-sans-cjk-fonts google-noto-serif-cjk-vf-fonts cjkuni-ukai-fonts cjkuni-uming-fonts \
        # google-arimo-fonts google-cousine-fonts google-tinos-fonts google-crosextra-caladea-fonts google-carlito-fonts
        filezilla \
        kwrite \
        distrobox podman-compose podman-docker \
        k3b cdrskin \
        btop \
        gparted \
        tailscale && \
        rpm -e --nodeps kmenuedit

# Copy custom fonts / Jigmo for Chinese, Buckeye for OSU purposes
COPY ./Jigmo/*.ttf /usr/share/fonts/jigmo-fonts/
COPY ./BuckeyeSans/*.otf /usr/share/fonts/buckeye-sans-fonts/
COPY ./BuckeyeSerif/*.otf /usr/share/fonts/buckeye-serif-fonts/

RUN systemctl set-default graphical.target && \
    systemctl enable plasmalogin.service tailscaled.service && \
# Font setup, service setup, base-system default /etc changes
    fc-cache -f /usr/share/fonts/{jigmo,buckeye-{sans,serif}}-fonts && \
# Disabled systemd-remount-fs for the annoying failure (cosmetic bug)
    systemctl mask sshd.socket sshd.service systemd-remount-fs.service && \
    touch /etc/containers/nodocker && \
    echo "XMODIFIERS=@im=fcitx" >> /etc/environment && \
    echo "export XMODIFIERS=@im=fcitx" > /etc/profile.d/fcitx.sh && \
# 3. Validate the image layout for bootc compliance, create tmpfiles.d needed for the missing /var setup; nuke extra cache dirs
    find /var/cache -mindepth 1 ! -path '/var/cache/libdnf5*' -delete && \
    rm -rf /var/lib/dnf /var/lib/rhsm /var/lib/authselect/checksum && \
    bootc container lint --no-truncate | awk '/^[[:space:]]*d \/var\// { $1=$1; print }' > /usr/lib/tmpfiles.d/bootc-autogenerated.conf && \
    awk '{print $2}' /usr/lib/tmpfiles.d/bootc-autogenerated.conf | sort -r | xargs -r rm -rf && \
    bootc container lint --no-truncate

LABEL containers.bootc=1
